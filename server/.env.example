# ── App ──
APP_ENV=development            # development | production
PORT=5000
CLIENT_URL=http://localhost:5173
PUBLIC_API_URL=                # public URL of this API (ngrok/Render). PayHere calls it back here.

# ── Database (MySQL 8) ──
DB_URL=jdbc:mysql://localhost:3306/glowvera_spring?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_password

# ── Auth ──
JWT_SECRET=generate-a-random-string-of-at-least-32-characters
JWT_EXPIRES_DAYS=7

# ── First admin account (created on startup if both are set) ──
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password-min-12-chars

# ── PayHere (sandbox) ──
PAYHERE_MERCHANT_ID=your-payhere-sandbox-merchant-id
PAYHERE_MERCHANT_SECRET=your-payhere-merchant-secret
PAYHERE_SANDBOX=true

# ── WhatsApp (digits only, with country code, no + and no leading 0) ──
WHATSAPP_NUMBER=94771234567

# ── Optional ──
SEED_DEMO_DATA=true            # inserts the 9 demo products once, when the catalog is empty
SWAGGER_ENABLED=true           # set false in production
FORWARD_HEADERS_STRATEGY=none  # set to "framework" when running behind a proxy (Render, Nginx)
